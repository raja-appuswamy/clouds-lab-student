# Copy to terraform.tfvars (git-ignored) and edit.
project     = "my-project-id"
image       = "us-central1-docker.pkg.dev/my-project-id/eurecomgpt/chat:v2"
alert_email = "you@eurecom.fr"

# The service account Terraform acts as (Task 1). Every API call it makes is authenticated
# as this identity, not yours, which is what makes the agent bounded. Required for this phase.
impersonate = "agent-operator@my-project-id.iam.gserviceaccount.com"
