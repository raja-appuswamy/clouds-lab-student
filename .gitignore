# .gitignore shipped to students (written by gen_skeleton.py as the student repo's
# .gitignore). Unlike the master's, it does NOT ignore submission/ — students must
# commit their submission report(s).

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local autograder output (regenerated by CI; do not commit)
results.json
score.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
